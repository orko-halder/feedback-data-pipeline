flowchart TB
    classDef auto fill:#132a22,stroke:#15803d,color:#bbf7d0
    classDef manual fill:#3b1616,stroke:#dc2626,color:#fecaca
    classDef code fill:#1f2a37,stroke:#60a5fa,color:#dbeafe
    classDef aws fill:#3b2f16,stroke:#a16207,color:#fde68a
    classDef future stroke-dasharray: 5 5

    subgraph AUTOMATIC["PARTS 1-2 — EVENT-DRIVEN (nobody types anything)"]
        U["aws s3 cp → raw-data/"]
        E1["S3 ObjectCreated<br/>prefix raw-data/reviews/"]
        E2["S3 ObjectCreated<br/>prefix raw-data/images/"]
        E3["S3 ObjectCreated<br/>prefix raw-data/calls/"]
        L1["Lambda text-validator<br/>→ validation-results/"]
        L2["S3 event on validation-results/<br/>→ Lambda comprehend-processor<br/>→ processed-data/reviews/"]
        L3["Lambda image-processor<br/>→ processed-data/images/"]
        L4["Lambda transcribe-starter<br/>→ StartTranscriptionJob"]
        T["Transcribe (async, minutes)"]
        EB["EventBridge: Transcribe Job State Change"]
        L5["Lambda transcript-collector<br/>→ processed-data/calls/"]

        U --> E1 --> L1 --> L2
        U --> E2 --> L3
        U --> E3 --> L4 --> T --> EB --> L5
    end

    subgraph SEMI["SURVEYS — MANUAL, batch by nature"]
        M1["you: bash infra/02_glue_catalog.sh<br/>(crawler → catalog table)"]
        M2["you: bash infra/03_glue_dq.sh<br/>(ruleset + evaluation run)"]
        M3["you: bash infra/11_sagemaker_survey_processing.sh<br/>uploads survey_processor.py to processing-code/<br/>→ Processing job → processed-data/surveys/"]
        M1 --> M2
        M1 --> M3
    end

    GAP["⛔ THE CHAIN STOPS HERE<br/>no S3 notification on processed-data/<br/>no EventBridge rule<br/>no schedule, no queue<br/><br/>Part 3 begins ONLY because a human runs a command"]

    L2 --> GAP
    L3 --> GAP
    L5 --> GAP
    M3 --> GAP

    subgraph P3["PART 3 — one manual command: python3 processing/build_insight_report.py"]
        direction TB
        S1["collect_documents()<br/>s3 ListObjectsV2 + GetObject<br/>over all 4 processed-data/ prefixes"]
        S2["feedback_document.normalise()<br/>NORMALISATION HAPPENS HERE<br/>in-process function call — no job, no event<br/>53 records → 53 documents, one shape"]
        S3["admissible_only() + manifest()<br/>47 sent, 6 excluded"]
        S4["redact_documents()<br/>comprehend:DetectPiiEntities, 1 call per doc<br/>filter_entities() keeps SKU/CUST/ORD"]
        S5["strip_inferred_signals()<br/>drops sentiment + rating_satisfaction_gap"]
        S6["build_user_message()<br/>one JSON payload: catalogue + manifest<br/>+ output_schema + 47 documents"]
        S7["invoke_model()<br/>bedrock-runtime:InvokeModel<br/>THE FM CALL — a direct function call,<br/>not a notification"]
        S8["extract_json → validate_report → cited_ids<br/>1 retry on bad JSON<br/>hallucinated-citation check"]
        S9["s3:PutObject insights/insight_report.json"]
        S1 --> S2 --> S3 --> S4 --> S5 --> S6 --> S7 --> S8 --> S9
    end

    GAP -->|"you type it"| S1

    SC["you: python3 scripts/score_insight_report.py<br/>report + data/ground_truth.json → precision/recall"]
    S9 --> SC

    subgraph P4["PART 4 — separate manual command"]
        Q1["quality_review.py<br/>reuses collect_documents()<br/>rule over sentiment vs rating<br/>→ quality-review/ + CloudWatch MismatchRate"]
    end
    GAP -->|"you type it"| Q1

    PROD["IN PRODUCTION this gap would be closed by ONE of:<br/>• EventBridge Scheduler (nightly batch)<br/>• Step Functions: crawler → DQ → processing → report<br/>• S3 notification on processed-data/ into SQS, drained on a timer<br/>NOT a per-record trigger: the whole POINT is one call over many documents"]
    GAP -.-> PROD

    class U,E1,E2,E3,L1,L2,L3,L4,T,EB,L5 auto
    class M1,M2,M3,GAP manual
    class S2,S3,S5,S6,S8,SC,Q1 code
    class S1,S4,S7,S9 aws
    class PROD future
