flowchart TB
    UP["You: aws s3 cp call_001.mp3<br/>s3://customer-feedback-analysis/raw-data/calls/"]

    subgraph L1["Lambda 1 — transcribe-starter (deployed, infra 09)"]
        S3EVT["S3 ObjectCreated<br/>prefix raw-data/calls/ suffix .mp3<br/>PUSH: S3 invokes the Lambda"]
        START["build_start_job_request<br/>ShowSpeakerLabels true, MaxSpeakerLabels 2<br/>StartTranscriptionJob -> returns immediately"]
    end

    UP --> S3EVT --> START

    TJOB["Transcribe runs ASYNC (minutes)<br/>nothing is waiting on it<br/>writes transcriptions/call_001.json"]
    START --> TJOB

    EVT["EventBridge default bus<br/>Transcribe Job State Change<br/>THIN event: job name + status only"]
    TJOB -->|"terminal state"| EVT

    RULE["Rule: feedback-pipeline-transcribe-job-rule<br/>source aws.transcribe<br/>TranscriptionJobStatus COMPLETED or FAILED<br/>CREATED BY infra 10"]
    DBG["Rule: debug-transcribe-catchall<br/>-> CloudWatch log group<br/>TEMPORARY, delete after verifying"]

    EVT --> RULE
    EVT -.->|"fan-out: same event, both rules"| DBG

    subgraph L2["Lambda 2 — transcript-collector (TODAY, infra 10)"]
        GET["GetTranscriptionJob<br/>the event is thin, so the job is re-read<br/>to get the transcript URI"]
        METRIC["PutMetricData<br/>CustomerFeedback/Calls TranscriptionJobs<br/>dimension Status, published for BOTH outcomes"]
        BRANCH{"status"}
        READ["s3:GetObject transcriptions/call_001.json<br/>merge_turns -> 5 turns"]
        ROLES["infer_roles<br/>exactly 2 speakers -> agent + customer<br/>otherwise unknown"]
        DOCS["build_sentiment_docs (design B)<br/>customer_all, agent_all, customer_end<br/>pack_turns keeps each under 5,000 BYTES"]
        COMP["BatchDetectSentiment<br/>one call, 3 documents<br/>results re-attached BY INDEX"]
        SUM["call_sentiment_summary<br/>byte-weighted mean per slot"]
        FAILREC["build_failure_record"]
    end

    RULE -->|"invokes (add-permission + put-targets)"| GET
    GET --> METRIC --> BRANCH
    BRANCH -->|"FAILED"| FAILREC
    BRANCH -->|"COMPLETED"| READ --> ROLES --> DOCS --> COMP --> SUM

    OUT["s3: processed-data/calls/call_001_processed.json<br/>speakers, turns, sentiment, sentiment_docs"]
    OUTF["s3: processed-data/calls/_failed/&lt;job&gt;.json"]
    SUM --> OUT
    FAILREC --> OUTF

    P3["Part 3 (not built)<br/>Claude on Bedrock reads the record<br/>summary, outcome, pain points"]
    OUT -.-> P3

    IAM["Role: feedback-pipeline-transcript-collector-role<br/>GetTranscriptionJob · GetObject transcriptions/*<br/>PutObject processed-data/calls/* · BatchDetectSentiment<br/>PutMetricData limited to one namespace"]
    IAM -.->|"execution role: what Lambda 2 may DO"| L2
    RULE -.->|"resource policy: who may INVOKE it"| L2

    classDef temp stroke-dasharray: 5 5
    class DBG,P3 temp
