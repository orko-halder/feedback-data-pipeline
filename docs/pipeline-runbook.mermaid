flowchart LR
    classDef cmd fill:#1f2a37,stroke:#4b5563,color:#e5e7eb
    classDef aws fill:#3b2f16,stroke:#a16207,color:#fde68a
    classDef ui  fill:#132a22,stroke:#15803d,color:#bbf7d0
    classDef gone stroke-dasharray: 5 5

    subgraph S0["0 — Bucket and test data"]
        C0["python3 scripts/generate_synthetic_data.py<br/>bash infra/00_s3.sh<br/>aws s3 cp data/ s3://.../raw-data/ --recursive"]
        A0["Bucket created; 20 reviews, 5 images,<br/>3 calls, 30 survey rows uploaded.<br/>5 reviews + 2 rows deliberately malformed"]
        U0["S3 &gt; customer-feedback-analysis<br/>raw-data/ with reviews|images|calls|surveys"]
    end
    C0 --> A0 --> U0

    subgraph S1["1 — Glue Crawler and Catalog (surveys)"]
        C1["bash infra/01_iam_glue.sh<br/>bash infra/02_glue_catalog.sh<br/>aws glue start-crawler"]
        A1["Crawler reads the CSV, INFERS the schema,<br/>writes METADATA only. Data never moves."]
        U1["Glue &gt; Crawlers (Succeeded)<br/>Glue &gt; Tables &gt; customer_feedback_db.surveys<br/>column types inferred from the CSV"]
    end
    C1 --> A1 --> U1

    subgraph S2["2 — Glue Data Quality on the catalog table"]
        C2["bash infra/03_glue_dq.sh<br/>aws glue start-data-quality-ruleset-evaluation-run<br/>--additional-run-options CloudWatchMetricsEnabled=true"]
        A2["Spark job ~90s applies DQDL:<br/>IsComplete + ColumnLength &gt; 0 (IsComplete<br/>alone does NOT catch empty strings)"]
        U2["Glue &gt; Data quality &gt; ruleset runs<br/>per-rule PASS/FAIL + score<br/>CloudWatch &gt; Metrics &gt; Glue Data Quality"]
    end
    C2 --> A2 --> U2

    subgraph S3["3 — DQ result to CloudWatch (event-driven)"]
        C3["bash infra/05_lambda_dq_publisher.sh<br/>(role + lambda + events put-rule + put-targets)"]
        A3["Glue DQ publishes a FAT event carrying<br/>the score. Rule matches source<br/>aws.glue-dataquality. No state filter:<br/>FAILED still carries a valid score."]
        U3["EventBridge &gt; Rules &gt; dq-success-rule<br/>&gt; Monitoring: TriggeredRules<br/>CloudWatch &gt; CustomerFeedback/DataQuality"]
    end
    C3 --> A3 --> U3

    subgraph S4["4 — Review validation (per record)"]
        C4["bash infra/04_lambda_text_validator.sh<br/>bash infra/07_s3_notifications.sh<br/>(ONE call replaces ALL bucket triggers)"]
        A4["S3 PUSHES ObjectCreated to the Lambda.<br/>8 checks; FATAL vs ADVISORY decides<br/>admissible. Keys are URL-encoded -&gt; unquote_plus."]
        U4["Lambda &gt; text-validator &gt; Monitor<br/>S3 &gt; validation-results/reviews/<br/>CloudWatch &gt; CustomerFeedback/TextQuality"]
    end
    C4 --> A4 --> U4

    subgraph S5["5 — Reviews to Comprehend"]
        C5["bash infra/06_lambda_comprehend.sh"]
        A5["Reads the validation verdict, FAILS CLOSED<br/>if missing. Sync API caps at 5,000 BYTES."]
        U5["Lambda &gt; comprehend-processor &gt; Monitor<br/>S3 &gt; processed-data/reviews/"]
    end
    C5 --> A5 --> U5

    subgraph S6["6 — Images to Textract"]
        C6["bash infra/08_lambda_image_processor.sh"]
        A6["AnalyzeDocument FORMS returns a BLOCK GRAPH<br/>(Relationships CHILD/VALUE), geometry 0-1.<br/>FORMS invents phantom keys -> output named<br/>textract_key_values for provenance."]
        U6["Lambda &gt; image-processor &gt; Monitor<br/>S3 &gt; processed-data/images/"]
    end
    C6 --> A6 --> U6

    subgraph S7["7 — Audio: start the job (async)"]
        C7["bash infra/09_lambda_transcribe_starter.sh"]
        A7["StartTranscriptionJob returns IMMEDIATELY.<br/>ShowSpeakerLabels true, MaxSpeakerLabels 2.<br/>Transcribe writes transcriptions/&lt;stem&gt;.json"]
        U7["Lambda &gt; transcribe-starter &gt; Monitor<br/>Transcribe &gt; Transcription jobs (In progress)<br/>job viewer shows speaker labels"]
    end
    C7 --> A7 --> U7

    subgraph S8["8 — Discover the event shape (temporary)"]
        C8["bash scripts/eventbridge_capture.sh aws.transcribe transcribe<br/>... later ...<br/>bash scripts/eventbridge_capture_remove.sh transcribe"]
        A8["Catch-all rule -> log group captures the REAL<br/>event. Docs were wrong for Glue DQ three ways.<br/>Logs allows only 10 resource policies per region."]
        U8["EventBridge &gt; Rules &gt; debug-transcribe-catchall<br/>CloudWatch &gt; Log groups &gt; /aws/events/transcribe-debug<br/>BOTH now deleted"]
    end
    C8 --> A8 --> U8

    subgraph S9["9 — Audio: collect the transcript"]
        C9["bash infra/10_lambda_transcript_collector.sh<br/>role + policy + sleep 12 + create-function<br/>+ put-rule + add-permission + put-targets"]
        A9["Event is THIN (name + status) so the Lambda<br/>calls GetTranscriptionJob. Design B: 3 docs<br/>per ROLE, each under 5,000 bytes.<br/>sleep 12 = IAM eventual consistency."]
        U9["Lambda &gt; transcript-collector &gt; Configuration<br/>&gt; Triggers = the rule; Permissions = resource policy<br/>EventBridge &gt; rule &gt; Monitoring: FailedInvocations 0"]
    end
    C9 --> A9 --> U9

    subgraph S10["10 — Fire the whole audio chain"]
        C10["aws s3 cp s3://.../call_001.mp3 s3://.../call_001.mp3<br/>--metadata-directive REPLACE --metadata rerun=2"]
        A10["Copy onto ITSELF fires ObjectCreated:<br/>Lambda1 -&gt; Transcribe -&gt; EventBridge -&gt; Lambda2<br/>-&gt; Comprehend -&gt; processed record"]
        U10["Transcribe job Complete<br/>S3 &gt; processed-data/calls/call_001_processed.json<br/>CloudWatch &gt; CustomerFeedback/Calls<br/>TranscriptionJobs Status=COMPLETED"]
    end
    C10 --> A10 --> U10

    subgraph S11["11 — Still to build"]
        C11["surveys -&gt; SageMaker Processing<br/>Part 3: Claude on Bedrock<br/>Part 4: sentiment vs rating mismatch"]
        A11["FM reads the processed records:<br/>summary, outcome, pain points"]
        U11["not yet visible anywhere"]
    end
    C11 --> A11 --> U11

    class C0,C1,C2,C3,C4,C5,C6,C7,C8,C9,C10,C11 cmd
    class A0,A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11 aws
    class U0,U1,U2,U3,U4,U5,U6,U7,U8,U9,U10,U11 ui
    class S8,S11 gone
