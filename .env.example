# Copy to .env and fill in, or export these before running.
# infra-template/common.sh derives DATA_BUCKET from PROJECT_INITIALS; the
# Python stages read DATA_BUCKET directly, so set it if you run them standalone.

# Short unique suffix for the globally-unique S3 bucket name (e.g. your initials).
PROJECT_INITIALS=abc

# Bucket the pipeline reads and writes. Must match what infra-template created.
DATA_BUCKET=customer-feedback-analysis-abc

# AWS region for every service call.
AWS_REGION=us-east-1

# Bedrock model for the insight report. Defaults to Claude Haiku 4.5 if unset.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
